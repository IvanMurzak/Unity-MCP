# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# OrcaRouter gateway configuration (optional)
# When ORCAROUTER_API_KEY is set, validate_mcp_openai.py uses the OrcaRouter gateway
# (https://api.orcarouter.ai/v1, model orcarouter/auto) instead of OpenAI.
# Get your API key from: https://www.orcarouter.ai
ORCAROUTER_API_KEY=sk-orca-your-api-key-here
